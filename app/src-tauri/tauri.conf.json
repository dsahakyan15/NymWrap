{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NymWrap", "version": "0.1.0", "identifier": "local.nymwrap.desktop",
  "build": { "beforeDevCommand": "npm run build", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label":"main", "title":"NymWrap", "width":1180, "height":800, "minWidth":860, "minHeight":640, "incognito":true }],
    "security": {
      "csp":"default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active":false }
}
