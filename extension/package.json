{
  "name": "nymwrap-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "browser:install": "node scripts/install-browser.mjs",
    "firefox:install": "node scripts/install-firefox.mjs",
    "probe:public:firefox": "npm run build && node scripts/probe-public-firefox.mjs",
    "test:native:firefox": "npm run build && cargo build --manifest-path ../Cargo.toml -p nw-core --example native_browser_fixture --release --locked && node --test tests/native/firefox.test.mjs",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/browser/*.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  }
}
